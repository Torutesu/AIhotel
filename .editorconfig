# エディタの基本設定を揃える（#94）。整形の詳細は各ワークスペースの ESLint に従う
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Markdown の行末の空白2つは改行の意味を持つため消さない
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
