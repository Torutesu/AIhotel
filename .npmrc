# pnpm-specific configuration
# Note: These settings are for pnpm only. npm will show warnings but they can be ignored.
# This project uses pnpm as the package manager.

# Suppress npm warnings (these settings are pnpm-specific)
loglevel=error

# Enable workspace support
auto-install-peers=true
strict-peer-dependencies=false

# Hoist dependencies to make them available to all packages
public-hoist-pattern[]=*use-sidecar*
public-hoist-pattern[]=*react-remove-scroll*
public-hoist-pattern[]=*next*
public-hoist-pattern[]=*react*
public-hoist-pattern[]=*react-dom*

