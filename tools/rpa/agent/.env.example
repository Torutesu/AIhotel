# コピーして .env を作る。リポジトリにコミットしない。
# 現地端末に置く場合、撤収時に必ず削除する（docs/当日手順_Windows実行.md の撤収手順）。

# LLMのAPIキー（browser-use はOSS版ならサービスのアカウント登録は不要。必要なのはこれ）
OPENAI_API_KEY=sk-...

# 使うモデル（省略時は run_agent.py の既定）
AGENT_MODEL=gpt-5.6-luna

# 接続先のChrome。構成A（同じ端末）なら既定のまま。
# 構成B（自分のPCから、ホテル端末のChromeへCDPリレー経由）なら http://<ホテル端末のIP>:9223
CDP_URL=http://127.0.0.1:9222
