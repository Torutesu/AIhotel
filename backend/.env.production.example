# ===========================================
# Hotel Revenue Management System - Backend（本番用テンプレート）
# ===========================================
# 本番のコンテナに渡す環境変数の最小構成（R-2-2）。値はシークレットマネージャーから注入するか、
# このファイルを写して --env-file で渡す。各項目の詳細は .env.example を参照。
#
# NODE_ENV は書かない（イメージが production を設定している。書くと上書きされる）。
# 空のまま残した項目は起動時の検証で止まる（意図的。使わない項目は行ごと消す）。
# seed（デモデータ）は本番で実行しない。最初の運営は `job create-platform-admin` で作る（docs/運用手順書.md）。

# 必須 ---------------------------------------------------------------
# マネージド PostgreSQL 16。TLS を必ず使う
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hotel_revenue?schema=public&sslmode=require"
# openssl rand -base64 64 | tr -d '\n' で生成した32文字以上の値
JWT_SECRET=
# 本番の画面の URL（CORS とメール内のリンクに使う）。未設定なら起動しない
FRONTEND_URL=https://app.example.com

# 中継（Vercel などの frontend）の構成に合わせる ----------------------
# frontend の中継の後ろで動かす。間にロードバランサが入るならその段数だけ増やす
TRUST_PROXY=1
# frontend の PROXY_SHARED_SECRET と同じ値（32文字以上）。backend がインターネットから届くなら必須
PROXY_SHARED_SECRET=

# メール（招待・一時パスワードを本人に届ける）----------------------------
MAIL_DRIVER=smtp
MAIL_FROM="AIレベニュー管理 <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# レポートの保存先（2レプリカ以上なら s3）--------------------------------
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# 競合価格（楽天トラベルの自動取得をするときだけ）------------------------
# RAKUTEN_APPLICATION_ID=

LOG_LEVEL=info
LOG_FORMAT=json
