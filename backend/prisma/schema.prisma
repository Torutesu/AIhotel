// Prisma schema — AI Revenue Management System
// マルチテナント構成: Tenant を最上位とし、全ドメインモデルが tenantId を保持する。
// テナント間データ分離は必須要件（要件定義書 §6）。クエリは必ず tenantId で絞り込むこと。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================
// Tenant (マルチテナント最上位)
// ======================================

model Tenant {
  id        String   @id @default(cuid())
  name      String // 例: 藤田観光
  code      String   @unique // 例: fujita-kanko
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  hotels                   Hotel[]
  roomTypes                RoomType[]
  priceRanks               PriceRank[]
  dailyData                DailyData[]
  dailyRoomData            DailyRoomData[]
  campaigns                Campaign[]
  competitors              Competitor[]
  competitorPriceData      CompetitorPriceData[]
  events                   Event[]
  auditLogs                AuditLog[]
  refreshTokens            RefreshToken[]
  monthlyBudgets           MonthlyBudget[]
  pricingStrategyConfigs   PricingStrategyConfig[]
  pricingLockPeriods       PricingLockPeriod[]
  hotelIntegrations        HotelIntegration[]
  competitorObservations   CompetitorRateObservation[]
  competitorFetchRuns      CompetitorFetchRun[]
  aiPriceRecommendations   AiPriceRecommendation[]
  monthlyLandingSimulation MonthlyLandingSimulation[]
  alerts                   Alert[]
  aiComments               AiComment[]
  bookingCurveData         BookingCurveData[]
  otaChannelData           OtaChannelData[]
  kpiSnapshots             KpiSnapshot[]
  reviewScores             ReviewScore[]
  groupBookings            GroupBooking[]
  userPreferences          UserPreference[]
}

// ======================================
// Authentication & Users
// ======================================

model User {
  id                 String    @id @default(cuid())
  // 運営（PLATFORM_ADMIN）はテナント横断のため tenantId は nullable。
  // ADMIN を含むテナント側のロールは必ず tenantId を持つ（#62）
  tenantId           String?
  tenant             Tenant?   @relation(fields: [tenantId], references: [id])
  email              String    @unique
  password           String
  name               String
  role               UserRole  @default(OPERATOR)
  hotelId            String?
  hotel              Hotel?    @relation(fields: [hotelId], references: [id])
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  // アカウント単位のロックアウト（#78）。連続失敗回数と、ロック解除時刻。
  // IP 単位のレート制限だけでは IP を分散した試行を止められないため
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  // 管理者が一時パスワードを発行したら true。本人が変更するまで、パスワード変更・
  // 自分の情報の取得・ログアウト以外の API を使えない（#89）
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  preferences   UserPreference[]

  @@index([tenantId])
  @@index([hotelId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id])
  // 生トークンではなく SHA-256 ハッシュを保存する（DB漏洩時のセッション乗っ取り対策）
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  // 回転（リフレッシュ）で使用済みになった時刻。null なら未使用の有効なトークン。
  // 行を消さずに失効させることで「一度使ったトークンの再提示」＝盗用を検知できる（#49-4）
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  // ログイン時・日次バッチの期限切れトークン一括削除で使う（S-9 / #49-4）
  @@index([expiresAt])
}

// 利用者ごとの画面表示設定（#51-2）。
// 以前はブラウザの localStorage にのみ保存していたため、端末・ブラウザを変えると
// 設定が消えていた。保存単位は (userId, hotelId) で、同じホテルの他の利用者には影響しない。
model UserPreference {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  // ダッシュボードの表示設定（showTopSitesSection / kpiItems）。
  // 読み出し側で必ず正規化する（services/preferencesService.ts）
  dashboard Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, hotelId])
  @@index([tenantId])
  @@index([hotelId])
}

// 要件定義書 §5 のロール定義に対応（#62 でテナント横断権限を ADMIN から分離）:
// PLATFORM_ADMIN=運営（サービス提供側。tenantId は null。唯一テナントを越えられる）
// ADMIN=管理者（テナント管理者。自テナント内で最上位。他テナントには一切アクセスできない）
// MANAGER=支配人・レベニューマネージャー / OPERATOR=現場フロント
enum UserRole {
  PLATFORM_ADMIN
  ADMIN
  MANAGER
  OPERATOR
}

// ======================================
// Hotel & Room Configuration
// ======================================

model Hotel {
  id               String     @id @default(cuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  address          String?
  phone            String?
  email            String?
  totalRooms       Int
  // 週末定義（チェックイン日基準）。デフォルトは金・土（F-DAILY-02）
  weekendDays      Json       @default("[5, 6]")
  // ホテルタイプとマーケット（#13）。既存ホテルは未設定（null）のまま、初期設定のチェックリストで埋めてもらう
  hotelType        HotelType?
  // 全国地方公共団体コード（都道府県2桁・市区町村6桁（検査数字付き））
  prefectureCode   String?
  municipalityCode String?
  // 観光エリア名（任意。例: 箱根、湯布院）
  marketArea       String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  users                    User[]
  roomTypes                RoomType[]
  priceRanks               PriceRank[]
  dailyData                DailyData[]
  campaigns                Campaign[]
  competitors              Competitor[]
  events                   Event[]
  monthlyBudgets           MonthlyBudget[]
  pricingStrategyConfigs   PricingStrategyConfig[]
  pricingLockPeriods       PricingLockPeriod[]
  hotelIntegrations        HotelIntegration[]
  aiPriceRecommendations   AiPriceRecommendation[]
  monthlyLandingSimulation MonthlyLandingSimulation[]
  alerts                   Alert[]
  aiComments               AiComment[]
  bookingCurveData         BookingCurveData[]
  otaChannelData           OtaChannelData[]
  kpiSnapshots             KpiSnapshot[]
  reviewScores             ReviewScore[]
  groupBookings            GroupBooking[]
  userPreferences          UserPreference[]

  @@index([tenantId])
}

// ホテルタイプ（#13。2026-08-01 クライアントMTGで整理した4区分）
enum HotelType {
  FULL_SERVICE // 総合型ホテル
  LIMITED_SERVICE // 宿泊特化
  RESORT // リゾートホテル
  RYOKAN // 旅館
}

// 連携先の記録（#13）。接続そのものは PMS 連携（#6）で作る。ここでは「どの製品を・どの方式で・どこまで進んだか」を残す
model HotelIntegration {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId          String
  hotel            Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  kind             IntegrationKind
  // 製品名（例: NEHOPS、TLリンカーン）。候補は frontend の INTEGRATION_PRODUCTS。候補外は自由入力
  product          String
  // 連携方式（例: Windows端末から CSV を送信、API）
  connectionMethod String?
  status           IntegrationStatus @default(PLANNED)
  note             String?
  updatedByUserId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([hotelId, kind])
  @@index([tenantId])
}

enum IntegrationKind {
  PMS
  SITE_CONTROLLER
}

enum IntegrationStatus {
  PLANNED // 予定（製品が決まった段階）
  TESTING // 接続試験中
  ACTIVE // 運用中
}

model RoomType {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String // スタンダードシングル、モデレートツイン等
  code      String // STD_SINGLE, MOD_TWIN 等
  capacity  Int
  count     Int
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyRoomData          DailyRoomData[]
  aiPriceRecommendations AiPriceRecommendation[]

  @@unique([hotelId, code])
  @@index([tenantId])
  @@index([hotelId])
}

// ======================================
// Pricing Configuration
// ======================================

// 料金ランクマスタ（最大40段階 — F-SET-02）
model PriceRank {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rank      Int // 1〜40
  label     String // R01, R02, ...
  price1P   Int
  price2P   Int
  price3P   Int?
  price4P   Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, rank])
  @@index([tenantId])
  @@index([hotelId])
}

// 価格戦略の重み付け設定（F-DP-02）
model PricingStrategyConfig {
  id               String @id @default(cuid())
  tenantId         String
  tenant           Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId          String @unique // ホテルごとに1設定
  hotel            Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  // 既定値は稼働率100%。設定を保存していないホテルの計算（OCCUPANCY_ONLY_WEIGHTS）と揃える（#17）
  weightOccupancy  Int    @default(100) // 稼働率重視 (%)
  weightAdr        Int    @default(0) // ADR重視 (%)
  weightCompetitor Int    @default(0) // 競合追従度 (%)

  // 以下は推奨ランクの調整（#17）。既定値は想定で、運用しながらホテルごとに変える前提
  // 競合と比べる人数（1 or 2）。null はホテルタイプから決める（宿泊特化=1名、それ以外=2名）
  competitorOccupancy Int?
  // 競合の中央値に対する自館の狙い（-30〜+30%）。+10 なら「競合より10%高く」
  competitorOffsetPct Int  @default(0)
  // 推奨ランクの下限・上限（null は料金ランクの全範囲）
  minRank             Int?
  maxRank             Int?
  // 前回の推奨から1回の再計算で動かせるランク数（null は制限なし）
  maxDailyRankChange  Int? @default(3)
  // 前回の推奨との差がこのランク数以内なら据え置く（0 は常に更新）
  hysteresisRanks     Int  @default(1)

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

// 推奨価格を更新しない期間（#17 のガードレール③）。団体・契約レートの日など。
// 期間内の日は再計算しても前回の推奨をそのまま残す
model PricingLockPeriod {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  reason          String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([hotelId, startDate])
}

// ======================================
// Daily Data & Performance
// ======================================

model DailyData {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId  String
  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date

  // 実績
  occupancy    Float?
  adr          Float?
  revPar       Float?
  totalRevenue Float?
  soldRooms    Int?
  guests       Int?

  // メタデータ
  isHoliday       Boolean @default(false)
  holidayName     String?
  eventInfo       String?
  externalFactors String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomData DailyRoomData[]

  @@unique([hotelId, date])
  @@index([tenantId])
  @@index([date])
}

model DailyRoomData {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dailyDataId String
  dailyData   DailyData @relation(fields: [dailyDataId], references: [id], onDelete: Cascade)
  roomTypeId  String
  roomType    RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  priceRank Int?
  price1P   Int?
  price2P   Int?
  price3P   Int?
  soldRooms Int?
  revenue   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dailyDataId, roomTypeId])
  @@index([tenantId])
  @@index([roomTypeId])
}

// 月次予算・前年実績（F-SET-04 / F-DASH-02）
model MonthlyBudget {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId  String
  hotel    Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  year     Int
  month    Int // 1-12

  budgetRevenue   Float?
  budgetRooms     Int?
  budgetAdr       Float?
  budgetOccupancy Float?
  budgetGuests    Int?

  // 前年実績（比較表示用）
  lastYearRevenue   Float?
  lastYearRooms     Int?
  lastYearAdr       Float?
  lastYearOccupancy Float?
  lastYearGuests    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, year, month])
  @@index([tenantId])
}

// ブッキングカーブ用予約積上データ（F-DAILY-01）
model BookingCurveData {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  stayDate    DateTime @db.Date // 宿泊日
  daysBefore  Int // 宿泊日までの残日数（0 = 当日）
  roomsBooked Int // その時点の予約積上室数
  capturedAt  DateTime @default(now())

  @@unique([hotelId, stayDate, daysBefore])
  @@index([tenantId])
  @@index([hotelId, stayDate])
}

// OTAチャネル別実績（キャンペーンフラグ含む）
model OtaChannelData {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  channel      String // 楽天トラベル、じゃらん、一休、Expedia、Agoda、公式
  roomsSold    Int?
  revenue      Float?
  adr          Float?
  campaignFlag Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, date, channel])
  @@index([tenantId])
}

// ======================================
// AI Predictions & Simulation
// ======================================

// AI推奨価格・需要レベル（F-DP-01 / F-DP-05）
model AiPriceRecommendation {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId    String
  hotel      Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId String?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  date       DateTime  @db.Date

  predictedOccupancy Float?
  predictedAdr       Float?
  recommendedRank    Int?
  recommendedPrice   Int?
  demandLevel        DemandLevel?
  confidence         Float? // 0-1
  modelVersion       String?
  // 推奨理由（#24 E4）。形は外部契約 v1 として固定する（services/forecast/rationale.ts）
  rationale          Json?
  computedAt         DateTime     @default(now())
  // 注意: PostgreSQL では NULL 同士が等しいとみなされないため、上の @@unique だけでは
  // roomTypeId IS NULL のホテル全体行の重複を防げない（同一日の推奨が複数行でき、
  // 料金カレンダーに同じ日が二重表示される）。部分ユニーク索引
  // AiPriceRecommendation_hotelId_date_null_roomtype_key を
  // migrations/20260911041135_ai_recommendation_partial_unique で手書きして補っている。
  // 部分索引（WHERE 句付き）は schema.prisma では表現できないため、
  // このモデルを変更する際はその索引が残っているか必ず確認すること（C-4）。

  @@unique([hotelId, date, roomTypeId])
  @@index([tenantId])
  @@index([hotelId, date])
}

// 需要予測レベル5段階（F-DP-05）
enum DemandLevel {
  A
  B
  C
  D
  E
}

// 月間着地シミュレーション（F-DP-04）
model MonthlyLandingSimulation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId  String
  hotel    Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  year     Int
  month    Int

  projectedRevenue   Float?
  projectedAdr       Float?
  projectedOccupancy Float?
  projectedRevPar    Float?
  projectedRooms     Int?
  computedAt         DateTime @default(now())

  @@unique([hotelId, year, month])
  @@index([tenantId])
}

// ======================================
// Alerts & AI Comments
// ======================================

// アラート（赤=即修正 / 黄=経過観察 — F-DASH-05）
model Alert {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId    String
  hotel      Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  severity   AlertSeverity
  /// 重要度レベル 1-5（5が最重要）。ダッシュボードには5・4のみ表示する（F-DASH-05）
  level      Int           @default(3)
  title      String
  message    String
  linkTab    String? // 遷移先タブ (dashboard/pricing/daily/analysis/reports/settings)
  targetDate DateTime?     @db.Date
  status     AlertStatus   @default(OPEN)
  /// 自動生成したアラートの識別子（#83）。例: LANDING_BELOW_BUDGET:2026-10。
  /// 同じ条件のアラートを重複して作らず、条件が消えたら自動で解決するために使う。手動・seed のアラートは null
  ruleKey    String?
  detectedAt DateTime      @default(now())
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([tenantId])
  @@index([hotelId, status])
  @@index([hotelId, level, status])
  @@index([hotelId, ruleKey])
}

enum AlertSeverity {
  RED
  YELLOW
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// AIコメント・インサイト（F-DASH-06 ほか各セクション）
model AiComment {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  section      String // dashboard-summary, pricing, daily, analysis 等
  content      String
  modelVersion String?
  generatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([hotelId, section, generatedAt])
}

// ======================================
// KPI Snapshots（月初比較・日付比較 — F-DASH-04）
// ======================================

model KpiSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  snapshotDate DateTime @db.Date // スナップショット取得日
  targetYear   Int // 対象月
  targetMonth  Int

  revenue   Float?
  soldRooms Int?
  adr       Float?
  occupancy Float?
  revPar    Float?
  guests    Int?

  createdAt DateTime @default(now())

  @@unique([hotelId, snapshotDate, targetYear, targetMonth])
  @@index([tenantId])
}

// ======================================
// Campaigns & Promotions
// ======================================

model Campaign {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  channel     String
  source      String   @default("manual") // ota, manual
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  description String?

  targetRooms  Int?
  actualRooms  Int?
  adrImpact    Float?
  revParImpact Float?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([hotelId])
  @@index([startDate, endDate])
}

// ======================================
// Competitor Analysis
// ======================================

model Competitor {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  category  String?
  // OTA別URL（F-SET-03）: { "rakuten": "...", "jalan": "...", "ikkyu": "...", "expedia": "...", "agoda": "..." }
  otaUrls   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceData    CompetitorPriceData[]
  observations CompetitorRateObservation[]

  @@index([tenantId])
  @@index([hotelId])
}

model CompetitorPriceData {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  price1P      Int?
  price2P      Int?
  price3P      Int?
  dataSource   String // scraping, manual, csv
  reliability  String? // high, medium, low
  // 価格を取得した日時（#9）。推奨には取得から48時間以内の値だけを使う。
  // null の行（この列を足す前の行）は updatedAt を取得日時とみなす
  observedAt   DateTime?
  // 満室・販売停止（#9）。価格は null になるが、競合の満室は需要のシグナルとして残す
  soldOut      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([competitorId, date])
  @@index([tenantId])
}

// 競合価格の観測値（#9 段階B）。取得元（OTA・公式サイト・CSV）ごとの生の値で、上書きせずに残す。
// CompetitorPriceData（競合×宿泊日の代表値）はここから作り直す（最新の取得のうち48時間以内の値の、人数ごとの最安値）
model CompetitorRateObservation {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competitorId String
  competitor   Competitor          @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  stayDate     DateTime            @db.Date
  // rakuten | jalan | ikkyu | expedia | agoda | booking | tripcom | official | manual
  source       String
  price1P      Int?
  price2P      Int?
  price3P      Int?
  soldOut      Boolean             @default(false)
  observedAt   DateTime
  // 取得ジョブの実行（CSV 取り込みは null）
  runId        String?
  run          CompetitorFetchRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())

  @@index([tenantId])
  @@index([competitorId, stayDate, source, observedAt])
}

// 競合価格の取得ジョブの実行記録（#9 段階B）。取得元ごとに1行。監視（連続失敗の検知）に使う
model CompetitorFetchRun {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId      String
  source       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  // running | succeeded | failed
  status       String    @default("running")
  observations Int       @default(0)
  errorMessage String?

  observationRows CompetitorRateObservation[]

  @@index([tenantId])
  @@index([hotelId, source, startedAt])
}

// ======================================
// Reviews（F-ANA-04）
// ======================================

model ReviewScore {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  source      String // google, tripadvisor, rakuten, jalan 等
  score       Float
  reviewCount Int?
  capturedAt  DateTime @default(now())

  @@index([tenantId])
  @@index([hotelId, source, capturedAt])
}

// ======================================
// Group Bookings（F-SET-05 / 課題No.53）
// ======================================

model GroupBooking {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId           String
  hotel             Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name              String
  stayStartDate     DateTime @db.Date
  stayEndDate       DateTime @db.Date
  rooms             Int
  guests            Int?
  // レベニュー影響ルール（ホテルごとに異なるため柔軟な Json で保持）
  revenueImpactRule Json?
  notes             String?
  status            String   @default("confirmed") // tentative, confirmed, cancelled
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([hotelId, stayStartDate])
}

// ======================================
// Events & External Factors
// ======================================

model Event {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name            String
  type            String // concert, sports, conference, festival 等
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  location        String?
  expectedImpact  String? // high, medium, low
  description     String?
  // オペレーター登録（F-DP-07）の記録用
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([hotelId])
  @@index([startDate, endDate])
}

// ======================================
// Audit & Logging（全設定変更を記録 — 要件定義書 §6 監査性）
// ======================================

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT 等
  entity    String // User, Hotel, DailyData 等
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
