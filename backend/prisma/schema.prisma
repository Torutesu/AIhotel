// Prisma schema — AI Revenue Management System
// マルチテナント構成: Tenant を最上位とし、全ドメインモデルが tenantId を保持する。
// テナント間データ分離は必須要件（要件定義書 §6）。クエリは必ず tenantId で絞り込むこと。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================
// Tenant (マルチテナント最上位)
// ======================================

model Tenant {
  id        String   @id @default(cuid())
  name      String // 例: 藤田観光
  code      String   @unique // 例: fujita-kanko
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  hotels                   Hotel[]
  roomTypes                RoomType[]
  priceRanks               PriceRank[]
  dailyData                DailyData[]
  dailyRoomData            DailyRoomData[]
  campaigns                Campaign[]
  competitors              Competitor[]
  competitorPriceData      CompetitorPriceData[]
  events                   Event[]
  auditLogs                AuditLog[]
  refreshTokens            RefreshToken[]
  monthlyBudgets           MonthlyBudget[]
  pricingStrategyConfigs   PricingStrategyConfig[]
  aiPriceRecommendations   AiPriceRecommendation[]
  monthlyLandingSimulation MonthlyLandingSimulation[]
  alerts                   Alert[]
  aiComments               AiComment[]
  bookingCurveData         BookingCurveData[]
  otaChannelData           OtaChannelData[]
  kpiSnapshots             KpiSnapshot[]
  reviewScores             ReviewScore[]
  groupBookings            GroupBooking[]
  agentDevices             AgentDevice[]
  agentPairingCodes        AgentPairingCode[]
  syncJobs                 SyncJob[]
  syncSnapshots            SyncSnapshot[]
  hotelSyncStates          HotelSyncState[]
}

// ======================================
// Authentication & Users
// ======================================

model User {
  id          String    @id @default(cuid())
  // システム提供側の ADMIN はテナント横断のため tenantId は nullable
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  email       String    @unique
  password    String
  name        String
  role        UserRole  @default(OPERATOR)
  hotelId     String?
  hotel       Hotel?    @relation(fields: [hotelId], references: [id])
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([tenantId])
  @@index([hotelId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  // 生トークンではなく SHA-256 ハッシュを保存する（DB漏洩時のセッション乗っ取り対策）
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// 要件定義書 §4 のロール定義に対応:
// ADMIN=システム提供側 / MANAGER=支配人・レベニューマネージャー / OPERATOR=現場フロント
enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
}

// ======================================
// Hotel & Room Configuration
// ======================================

model Hotel {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  phone       String?
  email       String?
  totalRooms  Int
  // 週末定義（チェックイン日基準）。デフォルトは金・土（F-DAILY-02）
  weekendDays Json     @default("[5, 6]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                    User[]
  roomTypes                RoomType[]
  priceRanks               PriceRank[]
  dailyData                DailyData[]
  campaigns                Campaign[]
  competitors              Competitor[]
  events                   Event[]
  monthlyBudgets           MonthlyBudget[]
  pricingStrategyConfigs   PricingStrategyConfig[]
  aiPriceRecommendations   AiPriceRecommendation[]
  monthlyLandingSimulation MonthlyLandingSimulation[]
  alerts                   Alert[]
  aiComments               AiComment[]
  bookingCurveData         BookingCurveData[]
  otaChannelData           OtaChannelData[]
  kpiSnapshots             KpiSnapshot[]
  reviewScores             ReviewScore[]
  groupBookings            GroupBooking[]
  agentDevices             AgentDevice[]
  agentPairingCodes        AgentPairingCode[]
  syncJobs                 SyncJob[]
  syncSnapshots            SyncSnapshot[]
  hotelSyncState           HotelSyncState?

  @@index([tenantId])
}

model RoomType {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String // スタンダードシングル、モデレートツイン等
  code      String // STD_SINGLE, MOD_TWIN 等
  capacity  Int
  count     Int
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyRoomData          DailyRoomData[]
  aiPriceRecommendations AiPriceRecommendation[]

  @@unique([hotelId, code])
  @@index([tenantId])
  @@index([hotelId])
}

// ======================================
// Pricing Configuration
// ======================================

// 料金ランクマスタ（最大40段階 — F-SET-02）
model PriceRank {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rank      Int // 1〜40
  label     String // R01, R02, ...
  price1P   Int
  price2P   Int
  price3P   Int?
  price4P   Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, rank])
  @@index([tenantId])
  @@index([hotelId])
}

// 価格戦略の重み付け設定（F-DP-02）
model PricingStrategyConfig {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId          String   @unique // ホテルごとに1設定
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  weightOccupancy  Int      @default(40) // 稼働率重視 (%)
  weightAdr        Int      @default(40) // ADR重視 (%)
  weightCompetitor Int      @default(20) // 競合追従度 (%)
  updatedByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
}

// ======================================
// Daily Data & Performance
// ======================================

model DailyData {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId  String
  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date

  // 実績
  occupancy    Float?
  adr          Float?
  revPar       Float?
  totalRevenue Float?
  soldRooms    Int?
  guests       Int?

  // メタデータ
  isHoliday       Boolean @default(false)
  holidayName     String?
  eventInfo       String?
  externalFactors String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomData DailyRoomData[]

  @@unique([hotelId, date])
  @@index([tenantId])
  @@index([date])
}

model DailyRoomData {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dailyDataId String
  dailyData   DailyData @relation(fields: [dailyDataId], references: [id], onDelete: Cascade)
  roomTypeId  String
  roomType    RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  priceRank Int?
  price1P   Int?
  price2P   Int?
  price3P   Int?
  soldRooms Int?
  revenue   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dailyDataId, roomTypeId])
  @@index([tenantId])
  @@index([roomTypeId])
}

// 月次予算・前年実績（F-SET-04 / F-DASH-02）
model MonthlyBudget {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId  String
  hotel    Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  year     Int
  month    Int // 1-12

  budgetRevenue   Float?
  budgetRooms     Int?
  budgetAdr       Float?
  budgetOccupancy Float?
  budgetGuests    Int?

  // 前年実績（比較表示用）
  lastYearRevenue   Float?
  lastYearRooms     Int?
  lastYearAdr       Float?
  lastYearOccupancy Float?
  lastYearGuests    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, year, month])
  @@index([tenantId])
}

// ブッキングカーブ用予約積上データ（F-DAILY-01）
model BookingCurveData {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  stayDate    DateTime @db.Date // 宿泊日
  daysBefore  Int // 宿泊日までの残日数（0 = 当日）
  roomsBooked Int // その時点の予約積上室数
  capturedAt  DateTime @default(now())

  @@unique([hotelId, stayDate, daysBefore])
  @@index([tenantId])
  @@index([hotelId, stayDate])
}

// OTAチャネル別実績（キャンペーンフラグ含む）
model OtaChannelData {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  channel      String // 楽天トラベル、じゃらん、一休、Expedia、Agoda、公式
  roomsSold    Int?
  revenue      Float?
  adr          Float?
  campaignFlag Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, date, channel])
  @@index([tenantId])
}

// ======================================
// AI Predictions & Simulation
// ======================================

// AI推奨価格・需要レベル（F-DP-01 / F-DP-05）
model AiPriceRecommendation {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId    String
  hotel      Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId String?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  date       DateTime  @db.Date

  predictedOccupancy Float?
  predictedAdr       Float?
  recommendedRank    Int?
  recommendedPrice   Int?
  demandLevel        DemandLevel?
  confidence         Float? // 0-1
  modelVersion       String?
  computedAt         DateTime     @default(now())

  @@unique([hotelId, date, roomTypeId])
  @@index([tenantId])
  @@index([hotelId, date])
}

// 需要予測レベル5段階（F-DP-05）
enum DemandLevel {
  A
  B
  C
  D
  E
}

// 月間着地シミュレーション（F-DP-04）
model MonthlyLandingSimulation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId  String
  hotel    Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  year     Int
  month    Int

  projectedRevenue   Float?
  projectedAdr       Float?
  projectedOccupancy Float?
  projectedRevPar    Float?
  projectedRooms     Int?
  computedAt         DateTime @default(now())

  @@unique([hotelId, year, month])
  @@index([tenantId])
}

// ======================================
// Alerts & AI Comments
// ======================================

// アラート（赤=即修正 / 黄=経過観察 — F-DASH-05）
model Alert {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId    String
  hotel      Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  severity   AlertSeverity
  /// 重要度レベル 1-5（5が最重要）。ダッシュボードには5・4のみ表示する（F-DASH-05）
  level      Int           @default(3)
  title      String
  message    String
  linkTab    String? // 遷移先タブ (dashboard/pricing/daily/analysis/reports/settings)
  targetDate DateTime?     @db.Date
  status     AlertStatus   @default(OPEN)
  detectedAt DateTime      @default(now())
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([tenantId])
  @@index([hotelId, status])
  @@index([hotelId, level, status])
}

enum AlertSeverity {
  RED
  YELLOW
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// AIコメント・インサイト（F-DASH-06 ほか各セクション）
model AiComment {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  section      String // dashboard-summary, pricing, daily, analysis 等
  content      String
  modelVersion String?
  generatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([hotelId, section, generatedAt])
}

// ======================================
// KPI Snapshots（月初比較・日付比較 — F-DASH-04）
// ======================================

model KpiSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  snapshotDate DateTime @db.Date // スナップショット取得日
  targetYear   Int // 対象月
  targetMonth  Int

  revenue   Float?
  soldRooms Int?
  adr       Float?
  occupancy Float?
  revPar    Float?
  guests    Int?

  createdAt DateTime @default(now())

  @@unique([hotelId, snapshotDate, targetYear, targetMonth])
  @@index([tenantId])
}

// ======================================
// Campaigns & Promotions
// ======================================

model Campaign {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  channel     String
  source      String   @default("manual") // ota, manual
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  description String?

  targetRooms  Int?
  actualRooms  Int?
  adrImpact    Float?
  revParImpact Float?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([hotelId])
  @@index([startDate, endDate])
}

// ======================================
// Competitor Analysis
// ======================================

model Competitor {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  category  String?
  // OTA別URL（F-SET-03）: { "rakuten": "...", "jalan": "...", "ikkyu": "...", "expedia": "...", "agoda": "..." }
  otaUrls   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceData CompetitorPriceData[]

  @@index([tenantId])
  @@index([hotelId])
}

model CompetitorPriceData {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  price1P      Int?
  price2P      Int?
  price3P      Int?
  dataSource   String // scraping, manual
  reliability  String? // high, medium, low
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([competitorId, date])
  @@index([tenantId])
}

// ======================================
// Reviews（F-ANA-04）
// ======================================

model ReviewScore {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  source      String // google, tripadvisor, rakuten, jalan 等
  score       Float
  reviewCount Int?
  capturedAt  DateTime @default(now())

  @@index([tenantId])
  @@index([hotelId, source, capturedAt])
}

// ======================================
// Group Bookings（F-SET-05 / 課題No.53）
// ======================================

model GroupBooking {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId           String
  hotel             Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name              String
  stayStartDate     DateTime @db.Date
  stayEndDate       DateTime @db.Date
  rooms             Int
  guests            Int?
  // レベニュー影響ルール（ホテルごとに異なるため柔軟な Json で保持）
  revenueImpactRule Json?
  notes             String?
  status            String   @default("confirmed") // tentative, confirmed, cancelled
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([hotelId, stayStartDate])
}

// ======================================
// Events & External Factors
// ======================================

model Event {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name            String
  type            String // concert, sports, conference, festival 等
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  location        String?
  expectedImpact  String? // high, medium, low
  description     String?
  // オペレーター登録（F-DP-07）の記録用
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([hotelId])
  @@index([startDate, endDate])
}

// ======================================
// Audit & Logging（全設定変更を記録 — 要件定義書 §6 監査性）
// ======================================

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT 等
  entity    String // User, Hotel, DailyData 等
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ======================================
// Connector（サイトコントローラー/PMS 画面操作連携 — docs/コネクタ連携設計.md）
// クライアントPC常駐エージェントとのPull型ジョブキュー。無人運転が既定。
// ======================================

// 連携対象システム
enum SyncTarget {
  LINCOLN
  NEHOPPS
}

enum SyncDirection {
  READ
  WRITE
}

// NEEDS_REVIEW: 自動で安全に進められず開発側対応待ち（当該ホテルWRITEは自動凍結）
enum SyncJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
  NEEDS_REVIEW
}

enum AgentDeviceRole {
  PRIMARY
  STANDBY
}

// エージェントのデバイス登録。トークンは SHA-256 ハッシュのみ保存（hashToken() 踏襲）
model AgentDevice {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId        String
  hotel          Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name           String // 例: フロントPC1
  role           AgentDeviceRole @default(PRIMARY)
  tokenHash      String          @unique
  tokenRotatedAt DateTime?
  agentVersion   String?
  lastSeenAt     DateTime?
  // kill switch: 失効後のリクエストは即401。isActive=false は一時停止（再有効化可能）
  revokedAt      DateTime?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  syncJobs SyncJob[]

  @@index([tenantId])
  @@index([hotelId])
}

// ペアリング用ワンタイムコード（10分有効・1回限り）。コードもハッシュのみ保存
model AgentPairingCode {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId       String
  hotel         Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  codeHash      String          @unique
  deviceName    String
  deviceRole    AgentDeviceRole @default(PRIMARY)
  expiresAt     DateTime
  usedAt        DateTime?
  createdById   String?
  createdAt     DateTime        @default(now())

  @@index([tenantId])
  @@index([hotelId])
}

model SyncJob {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId        String
  hotel          Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  target         SyncTarget
  direction      SyncDirection
  // 再実行安全のための冪等キー（生成元が決める。例: write:{hotelId}:{date}:{configVersion}）
  idempotencyKey String        @unique
  payload        Json // WRITE: 書き込む料金ランク差分 / READ: 取得範囲
  dryRun         Boolean       @default(false) // 入力まで行い送信しない（導入初期の検証運転用）
  status         SyncJobStatus @default(PENDING)
  priority       Int           @default(0)
  attemptCount   Int           @default(0)
  maxAttempts    Int           @default(3)
  notBefore      DateTime? // バックオフ再試行のスケジュール
  expiresAt      DateTime? // 期限切れの古いジョブは実行せずCANCELLED（陳腐化した価格を書かない）
  leaseExpiresAt DateTime? // リース方式: 期限切れRUNNINGはスイープが回収する
  result         Json? // READ結果 / 検証結果 / item単位の成否（部分失敗の再開用）
  errorCode      String? // エラー分類（AUTH_FAILED / SELECTOR_MISMATCH / VERIFY_MISMATCH 等）
  errorMessage   String?
  requestedById  String? // 手動作成時のユーザー。定常の自動生成ジョブはnull
  deviceId       String?
  device         AgentDevice?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  snapshots SyncSnapshot[]

  @@index([tenantId])
  @@index([hotelId, status])
  @@index([status, notBefore])
}

enum SnapshotKind {
  READ_RAW
  PRE_WRITE
  POST_WRITE
  FAILURE_EVIDENCE
}

// 生スナップショット。本体（HTML/スクショ）は lib/storage.ts 経由で保存し、DBには参照とメタのみ。
// READ_RAW は再パース（re-ingest）用、PRE_WRITE はロールバック用（docs/コネクタ連携設計.md §13）
model SyncSnapshot {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId     String
  hotel       Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  jobId       String?
  job         SyncJob?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  target      SyncTarget
  kind        SnapshotKind
  storageKey  String // lib/storage.ts の論理キー
  contentType String       @default("text/html")
  contentHash String // SHA-256（改ざん検知・重複排除）
  sanitized   Boolean      @default(false) // Cookie等マスク済みか（未サニタイズはAPIが受理しない）
  extracted   Json? // 抽出済み正規化データ（再パース時に更新）
  capturedAt  DateTime
  deleteAfter DateTime // 保持期限（READ_RAW/FAILURE_EVIDENCE 30日、PRE_WRITE/POST_WRITE 90日）
  createdAt   DateTime     @default(now())

  @@index([tenantId])
  @@index([hotelId, kind, capturedAt])
  @@index([deleteAfter])
}

// ホテル単位の連携ヘルス状態（鮮度SLO・凍結スイッチ・デッドマン検知の基準テーブル）
model HotelSyncState {
  id                    String    @id @default(cuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId               String    @unique
  hotel                 Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  lastSuccessfulReadAt  DateTime?
  lastSuccessfulWriteAt DateTime?
  consecutiveReadFails  Int       @default(0)
  writeFrozen           Boolean   @default(false) // 凍結スイッチ（READは継続、WRITEのみ停止）
  writeFrozenReason     String?
  manualModeActive      Boolean   @default(false) // 手動反映モード（デフォルト無効。発動は開発側判断）
  // 定期READスケジューラ（スイープが鮮度に応じてREADジョブを自動生成する — §14.1）
  autoReadEnabled       Boolean   @default(true)
  readIntervalMinutes   Int       @default(360) // 鮮度SLO 6時間（§10.5）に合わせた既定値
  updatedAt             DateTime  @updatedAt

  @@index([tenantId])
}

// 開発側通知（Ops Alerting）の抑制状態。hotel × 事象種別のdedupeとクールダウン管理（§14.4）
model OpsAlertState {
  id             String    @id @default(cuid())
  // 全テナント横断の運用テーブルだがテナント分離規約に従い tenantId を保持する
  tenantId       String
  hotelId        String
  eventKey       String // 事象種別（AUTH_FAILED / STALE_READ_12H / ALL_DEVICES_DOWN 等）
  severity       String // SEV1 / SEV2 / SEV3
  firstFiredAt   DateTime
  lastFiredAt    DateTime
  lastNotifiedAt DateTime?
  resolvedAt     DateTime?
  fireCount      Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([hotelId, eventKey])
  @@index([tenantId])
  @@index([resolvedAt])
}
