// Prisma schema — AI Revenue Management System
// マルチテナント構成: Tenant を最上位とし、全ドメインモデルが tenantId を保持する。
// テナント間データ分離は必須要件（要件定義書 §6）。クエリは必ず tenantId で絞り込むこと。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================
// Tenant (マルチテナント最上位)
// ======================================

model Tenant {
  id        String   @id @default(cuid())
  name      String // 例: 藤田観光
  code      String   @unique // 例: fujita-kanko
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                      User[]
  hotels                     Hotel[]
  roomTypes                  RoomType[]
  priceRanks                 PriceRank[]
  dailyData                  DailyData[]
  dailyRoomData              DailyRoomData[]
  campaigns                  Campaign[]
  competitors                Competitor[]
  competitorPriceData        CompetitorPriceData[]
  events                     Event[]
  auditLogs                  AuditLog[]
  refreshTokens              RefreshToken[]
  monthlyBudgets             MonthlyBudget[]
  pricingStrategyConfigs     PricingStrategyConfig[]
  aiPriceRecommendations     AiPriceRecommendation[]
  monthlyLandingSimulation   MonthlyLandingSimulation[]
  alerts                     Alert[]
  aiComments                 AiComment[]
  bookingCurveData           BookingCurveData[]
  otaChannelData             OtaChannelData[]
  kpiSnapshots               KpiSnapshot[]
  reviewScores               ReviewScore[]
  groupBookings              GroupBooking[]
  priceDecisions             PriceDecision[]
  operatorPreferenceProfiles OperatorPreferenceProfile[]
  operatorForecasts          OperatorForecast[]
  forecastVarianceSettings   ForecastVarianceSetting[]
}

// ======================================
// Authentication & Users
// ======================================

model User {
  id          String    @id @default(cuid())
  // システム提供側の ADMIN はテナント横断のため tenantId は nullable
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  email       String    @unique
  password    String
  name        String
  role        UserRole  @default(OPERATOR)
  hotelId     String?
  hotel       Hotel?    @relation(fields: [hotelId], references: [id])
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  priceDecisions    PriceDecision[]
  operatorForecasts OperatorForecast[]

  @@index([tenantId])
  @@index([hotelId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  // 生トークンではなく SHA-256 ハッシュを保存する（DB漏洩時のセッション乗っ取り対策）
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// 要件定義書 §4 のロール定義に対応:
// ADMIN=システム提供側 / MANAGER=支配人・レベニューマネージャー / OPERATOR=現場フロント
enum UserRole {
  ADMIN
  MANAGER
  OPERATOR
}

// ======================================
// Hotel & Room Configuration
// ======================================

model Hotel {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  phone       String?
  email       String?
  totalRooms  Int
  // 週末定義（チェックイン日基準）。デフォルトは金・土（F-DAILY-02）
  weekendDays Json     @default("[5, 6]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                      User[]
  roomTypes                  RoomType[]
  priceRanks                 PriceRank[]
  dailyData                  DailyData[]
  campaigns                  Campaign[]
  competitors                Competitor[]
  events                     Event[]
  monthlyBudgets             MonthlyBudget[]
  pricingStrategyConfigs     PricingStrategyConfig[]
  aiPriceRecommendations     AiPriceRecommendation[]
  monthlyLandingSimulation   MonthlyLandingSimulation[]
  alerts                     Alert[]
  aiComments                 AiComment[]
  bookingCurveData           BookingCurveData[]
  otaChannelData             OtaChannelData[]
  kpiSnapshots               KpiSnapshot[]
  reviewScores               ReviewScore[]
  groupBookings              GroupBooking[]
  priceDecisions             PriceDecision[]
  operatorPreferenceProfiles OperatorPreferenceProfile[]
  operatorForecasts          OperatorForecast[]
  forecastVarianceSetting    ForecastVarianceSetting?

  @@index([tenantId])
}

model RoomType {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String // スタンダードシングル、モデレートツイン等
  code      String // STD_SINGLE, MOD_TWIN 等
  capacity  Int
  count     Int
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyRoomData          DailyRoomData[]
  aiPriceRecommendations AiPriceRecommendation[]
  priceDecisions         PriceDecision[]

  @@unique([hotelId, code])
  @@index([tenantId])
  @@index([hotelId])
}

// ======================================
// Pricing Configuration
// ======================================

// 料金ランクマスタ（最大40段階 — F-SET-02）
model PriceRank {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rank      Int // 1〜40
  label     String // R01, R02, ...
  price1P   Int
  price2P   Int
  price3P   Int?
  price4P   Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, rank])
  @@index([tenantId])
  @@index([hotelId])
}

// 価格戦略の重み付け設定（F-DP-02）
model PricingStrategyConfig {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId          String   @unique // ホテルごとに1設定
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  weightOccupancy  Int      @default(40) // 稼働率重視 (%)
  weightAdr        Int      @default(40) // ADR重視 (%)
  weightCompetitor Int      @default(20) // 競合追従度 (%)
  updatedByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
}

// ======================================
// Daily Data & Performance
// ======================================

model DailyData {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId  String
  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date

  // 実績
  occupancy    Float?
  adr          Float?
  revPar       Float?
  totalRevenue Float?
  soldRooms    Int?
  guests       Int?

  // メタデータ
  isHoliday       Boolean @default(false)
  holidayName     String?
  eventInfo       String?
  externalFactors String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomData DailyRoomData[]

  @@unique([hotelId, date])
  @@index([tenantId])
  @@index([date])
}

model DailyRoomData {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dailyDataId String
  dailyData   DailyData @relation(fields: [dailyDataId], references: [id], onDelete: Cascade)
  roomTypeId  String
  roomType    RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  priceRank Int?
  price1P   Int?
  price2P   Int?
  price3P   Int?
  soldRooms Int?
  revenue   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dailyDataId, roomTypeId])
  @@index([tenantId])
  @@index([roomTypeId])
}

// 月次予算・前年実績（F-SET-04 / F-DASH-02）
model MonthlyBudget {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId  String
  hotel    Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  year     Int
  month    Int // 1-12

  budgetRevenue   Float?
  budgetRooms     Int?
  budgetAdr       Float?
  budgetOccupancy Float?
  budgetGuests    Int?

  // 前年実績（比較表示用）
  lastYearRevenue   Float?
  lastYearRooms     Int?
  lastYearAdr       Float?
  lastYearOccupancy Float?
  lastYearGuests    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, year, month])
  @@index([tenantId])
}

// ブッキングカーブ用予約積上データ（F-DAILY-01）
model BookingCurveData {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  stayDate    DateTime @db.Date // 宿泊日
  daysBefore  Int // 宿泊日までの残日数（0 = 当日）
  roomsBooked Int // その時点の予約積上室数
  capturedAt  DateTime @default(now())

  @@unique([hotelId, stayDate, daysBefore])
  @@index([tenantId])
  @@index([hotelId, stayDate])
}

// OTAチャネル別実績（キャンペーンフラグ含む）
model OtaChannelData {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  channel      String // 楽天トラベル、じゃらん、一休、Expedia、Agoda、公式
  roomsSold    Int?
  revenue      Float?
  adr          Float?
  campaignFlag Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, date, channel])
  @@index([tenantId])
}

// ======================================
// AI Predictions & Simulation
// ======================================

// AI推奨価格・需要レベル（F-DP-01 / F-DP-05）
model AiPriceRecommendation {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId    String
  hotel      Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId String?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  date       DateTime  @db.Date

  predictedOccupancy Float?
  predictedAdr       Float?
  recommendedRank    Int?
  recommendedPrice   Int?
  demandLevel        DemandLevel?
  confidence         Float? // 0-1
  modelVersion       String?
  computedAt         DateTime     @default(now())

  @@unique([hotelId, date, roomTypeId])
  @@index([tenantId])
  @@index([hotelId, date])
}

// 需要予測レベル5段階（F-DP-05）
enum DemandLevel {
  A
  B
  C
  D
  E
}

// 月間着地シミュレーション（F-DP-04）
model MonthlyLandingSimulation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId  String
  hotel    Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  year     Int
  month    Int

  projectedRevenue   Float?
  projectedAdr       Float?
  projectedOccupancy Float?
  projectedRevPar    Float?
  projectedRooms     Int?
  computedAt         DateTime @default(now())

  @@unique([hotelId, year, month])
  @@index([tenantId])
}

// ======================================
// 運営担当者の意向と差異（F-DP-08 / F-DP-09 / F-DP-10）
// ======================================

// 運営担当者が実際に適用した価格判断の記録（追記のみ・更新しない）。
//
// AI推奨（AiPriceRecommendation）は再計算のたびに上書きされるため、判断した
// 時点の推奨値をスナップショットとして保持する。これにより「AIが推奨した値」と
// 「運営担当者が実際にやった値」の差異を、後から再計算の影響を受けずに追跡できる。
// 1日に複数回判断が入りうる（意向の変遷そのものが学習材料）ため一意制約は付けない。
model PriceDecision {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId    String
  hotel      Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  // null = ホテル全体の判断（AiPriceRecommendation と同じ粒度）
  roomTypeId String?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  date       DateTime  @db.Date

  // 判断時点のAI推奨スナップショット
  aiRecommendedRank    Int?
  aiRecommendedPrice   Int?
  aiPredictedOccupancy Float?
  aiPredictedAdr       Float?
  aiDemandLevel        DemandLevel?
  aiConfidence         Float?
  aiModelVersion       String?

  // 運営担当者が実際に適用した値
  appliedRank  Int?
  appliedPrice Int?

  // 意向。decisionType はサーバ側で AI推奨との差から導出する（クライアント入力を信用しない）
  decisionType PriceDecisionType
  intentReason PriceIntentReason
  intentNote   String? // 意向の自由記述（現場の言葉をそのまま残す）

  decidedByUserId String?
  decidedBy       User?    @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([hotelId, date])
  @@index([hotelId, intentReason])
}

// AI推奨に対する運営担当者の動かし方（サーバ側で導出）
enum PriceDecisionType {
  ACCEPTED // AI推奨をそのまま適用
  RAISED // AI推奨より上げた
  LOWERED // AI推奨より下げた
}

// 運営担当者の意向カテゴリ。継続学習ではこの分類ごとに傾向を集計する
enum PriceIntentReason {
  FOLLOW_AI // AI推奨に従う
  COMPETITOR_MOVE // 競合の動きに合わせた
  EVENT_DEMAND // イベント・地域需要を織り込んだ
  GROUP_BLOCK // 団体・グループ受入の都合
  OTA_CAMPAIGN // OTAキャンペーン参加のため
  BUDGET_PRESSURE // 予算達成のため
  FIELD_INSIGHT // 現場の肌感覚・常連動向
  OPERATION_LIMIT // 清掃・人員などのオペレーション制約
  OTHER
}

// 継続学習（F-DP-10）: 蓄積された PriceDecision と実績から、運営担当者が
// AI推奨をどちら向きにどれだけ動かす傾向があるかをセグメント別に学習した結果。
//
// 学習結果は自動では予測に反映しない。MANAGER が内容を確認して isEnabled を
// true にしたセグメントのみ需要予測へ適用する（human-in-the-loop）。
// 誤った意向をそのまま増幅しないための安全弁であり、適用値は
// appliedRankDelta にクランプ済みの整数として保持する。
model OperatorPreferenceProfile {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId  String
  hotel    Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  // セグメント: 需要レベル × 曜日区分（例 "A:weekend"）
  segmentKey  String
  demandLevel DemandLevel?
  dayType     String // weekend / weekday（Hotel.weekendDays 準拠）

  sampleCount      Int // 学習に使った判断件数
  avgRankDelta     Float // 適用ランク − AI推奨ランク の平均
  medianRankDelta  Float // 同 中央値（外れ値に強い代表値）
  appliedRankDelta Int // 予測に実際に適用する補正値（丸め・上限クランプ後）
  outperformRate   Float? // 実績が判明した判断のうち、運営判断がAI推奨を上回った割合
  evaluatedCount   Int    @default(0) // outperformRate の母数

  dominantIntentReason PriceIntentReason? // そのセグメントで最も多かった意向

  isEnabled       Boolean  @default(false) // true のセグメントのみ予測に反映
  enabledByUserId String?
  modelVersion    String
  computedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([hotelId, segmentKey])
  @@index([tenantId])
  @@index([hotelId, isEnabled])
}

// ======================================
// AI予測とレベニュー担当予測の突き合わせ（F-DP-11 / F-DP-12）
// ======================================

// レベニュー担当が立てた日別予測。AI予測と同じ土俵で比較するための人間側の見立て。
//
// 同じ宿泊日に対して何度でも立て直せる。version=1 が「初期予測」で、これがAIの
// 初期予測との差異分析の基準になる。以降の改訂は version をインクリメントして
// 追記し、上書きしない（見立てがどう変わったかも分析対象になるため）。
//
// AI予測（AiPriceRecommendation）は再計算のたびに上書きされるため、記録時点の
// AI予測をスナップショットとして焼き込む。これがないと「そのときAIは何と言って
// いたか」が失われ、初期予測同士の差異が後から書き換わってしまう。
model OperatorForecast {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId  String
  hotel    Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  /// 1 = 初期予測。2以降は改訂
  version  Int      @default(1)

  // レベニュー担当の予測。稼働率とADRが基準で、室数・売上は未入力なら総室数から導出する
  forecastOccupancy Float? // 0-1
  forecastAdr       Float?
  forecastSoldRooms Int?
  forecastRevenue   Float?

  // 記録時点のAI予測スナップショット
  aiOccupancy    Float?
  aiAdr          Float?
  aiSoldRooms    Int?
  aiRevenue      Float?
  aiDemandLevel  DemandLevel?
  aiConfidence   Float?
  aiModelVersion String?

  // 差異の意図・背景。閾値（ForecastVarianceSetting）を超えた日は理由を必須にする
  exceededThreshold Boolean                 @default(false)
  varianceReason    ForecastVarianceReason?
  varianceNote      String?

  createdByUserId String?
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@unique([hotelId, date, version])
  @@index([tenantId])
  @@index([hotelId, date])
  @@index([hotelId, varianceReason])
}

// 予測が食い違う背景の分類。価格判断の理由（PriceIntentReason）とは別軸で、
// 「なぜAIと違う数字を見ているのか」を表す
enum ForecastVarianceReason {
  BOOKING_PACE // 予約の入り方が想定と違う
  COMPETITOR_SUPPLY // 競合の供給・価格の状況
  EVENT_LOCAL // 地域イベント・催事の影響度
  GROUP_CONTRACT // 団体・法人契約の確度
  REPEAT_GUEST // 常連・リピーターの動向
  MARKET_TREND // 市況・季節性の見立て
  OTA_CAMPAIGN // OTA施策の効き方
  RENOVATION_OPS // 改装・客室閉鎖・人員などの運営制約
  DATA_DOUBT // AI予測の前提データに疑義がある
  OTHER
}

// 「意図・背景の記入を必須にする乖離幅」のホテル別設定（F-DP-12）。
// 全件必須にすると形骸化し、全件任意にすると肝心の箇所が空欄で残るため、
// 意味のある乖離にだけ理由を求める。
model ForecastVarianceSetting {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId  String @unique
  hotel    Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  /// 稼働率の乖離幅（pt換算。0.05 = 5pt）
  occupancyPtThreshold Float @default(0.05)
  /// ADRの乖離率（0.05 = 5%）
  adrPctThreshold      Float @default(0.05)
  /// 売上の乖離率（0.10 = 10%）
  revenuePctThreshold  Float @default(0.1)

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

// ======================================
// Alerts & AI Comments
// ======================================

// アラート（赤=即修正 / 黄=経過観察 — F-DASH-05）
model Alert {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId    String
  hotel      Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  severity   AlertSeverity
  /// 重要度レベル 1-5（5が最重要）。ダッシュボードには5・4のみ表示する（F-DASH-05）
  level      Int           @default(3)
  title      String
  message    String
  linkTab    String? // 遷移先タブ (dashboard/pricing/daily/analysis/reports/settings)
  targetDate DateTime?     @db.Date
  status     AlertStatus   @default(OPEN)
  detectedAt DateTime      @default(now())
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([tenantId])
  @@index([hotelId, status])
  @@index([hotelId, level, status])
}

enum AlertSeverity {
  RED
  YELLOW
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// AIコメント・インサイト（F-DASH-06 ほか各セクション）
model AiComment {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  section      String // dashboard-summary, pricing, daily, analysis 等
  content      String
  modelVersion String?
  generatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([hotelId, section, generatedAt])
}

// ======================================
// KPI Snapshots（月初比較・日付比較 — F-DASH-04）
// ======================================

model KpiSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  snapshotDate DateTime @db.Date // スナップショット取得日
  targetYear   Int // 対象月
  targetMonth  Int

  revenue   Float?
  soldRooms Int?
  adr       Float?
  occupancy Float?
  revPar    Float?
  guests    Int?

  createdAt DateTime @default(now())

  @@unique([hotelId, snapshotDate, targetYear, targetMonth])
  @@index([tenantId])
}

// ======================================
// Campaigns & Promotions
// ======================================

model Campaign {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  channel     String
  source      String   @default("manual") // ota, manual
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  description String?

  targetRooms  Int?
  actualRooms  Int?
  adrImpact    Float?
  revParImpact Float?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([hotelId])
  @@index([startDate, endDate])
}

// ======================================
// Competitor Analysis
// ======================================

model Competitor {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  category  String?
  // OTA別URL（F-SET-03）: { "rakuten": "...", "jalan": "...", "ikkyu": "...", "expedia": "...", "agoda": "..." }
  otaUrls   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceData CompetitorPriceData[]

  @@index([tenantId])
  @@index([hotelId])
}

model CompetitorPriceData {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  price1P      Int?
  price2P      Int?
  price3P      Int?
  dataSource   String // scraping, manual
  reliability  String? // high, medium, low
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([competitorId, date])
  @@index([tenantId])
}

// ======================================
// Reviews（F-ANA-04）
// ======================================

model ReviewScore {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  source      String // google, tripadvisor, rakuten, jalan 等
  score       Float
  reviewCount Int?
  capturedAt  DateTime @default(now())

  @@index([tenantId])
  @@index([hotelId, source, capturedAt])
}

// ======================================
// Group Bookings（F-SET-05 / 課題No.53）
// ======================================

model GroupBooking {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId           String
  hotel             Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name              String
  stayStartDate     DateTime @db.Date
  stayEndDate       DateTime @db.Date
  rooms             Int
  guests            Int?
  // レベニュー影響ルール（ホテルごとに異なるため柔軟な Json で保持）
  revenueImpactRule Json?
  notes             String?
  status            String   @default("confirmed") // tentative, confirmed, cancelled
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([hotelId, stayStartDate])
}

// ======================================
// Events & External Factors
// ======================================

model Event {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name            String
  type            String // concert, sports, conference, festival 等
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  location        String?
  expectedImpact  String? // high, medium, low
  description     String?
  // オペレーター登録（F-DP-07）の記録用
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([hotelId])
  @@index([startDate, endDate])
}

// ======================================
// Audit & Logging（全設定変更を記録 — 要件定義書 §6 監査性）
// ======================================

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT 等
  entity    String // User, Hotel, DailyData 等
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
