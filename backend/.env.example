# ===========================================
# Hotel Revenue Management System - Backend
# Environment Configuration Template
# ===========================================
# このファイルをコピーして .env を作成してください
# cp .env.example .env

# -----------------
# Server Settings
# -----------------
NODE_ENV=development
PORT=3001

# -----------------
# Frontend URL (CORS)
# -----------------
FRONTEND_URL=http://localhost:3000

# -----------------
# Database Settings
# -----------------
# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# ローカル開発（docker/docker-compose.dev.yml のPostgres）:
DATABASE_URL="postgresql://postgres:password@localhost:5432/hotel_revenue_db?schema=public"
#
# 本番環境ではクラウドのマネージドPostgreSQLを利用する想定。特定クラウドの
# SDKには依存せず、DATABASE_URL（標準の postgresql:// 接続文字列）のみで
# 差し替え可能な構成になっている。
#
# AWS RDS for PostgreSQL の例:
# DATABASE_URL="postgresql://USER:PASSWORD@your-db-instance.xxxxxxxxxx.ap-northeast-1.rds.amazonaws.com:5432/hotel_revenue_db?schema=public&sslmode=require"
#
# GCP Cloud SQL for PostgreSQL の例（Public IP + SSL、もしくはCloud SQL Auth Proxy経由でlocalhost接続も可）:
# DATABASE_URL="postgresql://USER:PASSWORD@<CLOUD_SQL_PUBLIC_IP>:5432/hotel_revenue_db?schema=public&sslmode=require"

# -----------------
# Authentication (JWT)
# -----------------
# 必須。未設定、または32文字未満の場合はアプリ起動時に例外を投げて即座に停止する
# （backend/src/lib/auth.ts の requireJwtSecret を参照）。
# openssl rand -base64 64 で生成可能
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------
# API Rate Limiting
# -----------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ログイン試行専用のレート制限（ブルートフォース対策、W-4）。
# 未設定時のデフォルトは10（固定15分ウィンドウあたりの最大試行回数。
# ウィンドウ幅自体は backend/src/routes/auth.ts にハードコードされており
# RATE_LIMIT_WINDOW_MS の影響は受けない）。
LOGIN_RATE_LIMIT_MAX=10

# -----------------
# Logging
# -----------------
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------
# External APIs (Optional)
# -----------------
# OTA連携用API（楽天トラベル、Booking.comなど）
# RAKUTEN_API_KEY=
# BOOKING_API_KEY=
# JALAN_API_KEY=

# 気象データAPI（天気予報連携用）
# WEATHER_API_KEY=

# -----------------
# AI/ML Services (Optional)
# -----------------
# Claude API（Anthropic）— AIコメント自動生成機能用（Phase 4で実装予定）
# ANTHROPIC_API_KEY=

# -----------------
# Redis (Optional - for caching/sessions)
# -----------------
# REDIS_URL=redis://localhost:6379

# -----------------
# PMSデータの自動取込（docs/pms-ingest-design.md §A-3）
# -----------------
# バックエンド常駐スケジューラで自動取得を回すか。複数インスタンス運用時は false にし、
# 外部スケジューラから POST /api/v1/ingest/run を1本だけ叩くこと
# INGEST_SCHEDULER_ENABLED=false
# 起床間隔（ms）。期待到着時刻の判定粒度もこれに揃う
# INGEST_SCHEDULER_INTERVAL_MS=300000
# LOCAL_DIR コネクタが読むルートディレクトリ。クローラ/RPA/共有フォルダ同期の投入先
# INGEST_INBOX_DIR=ingest-inbox
# HTTPS コネクタの資格情報。DBには secretRef（キー名）だけを保存する
# INGEST_SECRETS={"tl-lincoln":"Bearer xxxxx"}
