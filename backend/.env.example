# ===========================================
# Hotel Revenue Management System - Backend
# Environment Configuration Template
# ===========================================
# このファイルをコピーして .env を作成してください
# cp .env.example .env

# -----------------
# Server Settings
# -----------------
NODE_ENV=development
PORT=3001

# -----------------
# Frontend URL (CORS)
# -----------------
FRONTEND_URL=http://localhost:3000

# -----------------
# Database Settings
# -----------------
# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# ローカル開発（docker/docker-compose.dev.yml のPostgres）:
DATABASE_URL="postgresql://postgres:password@localhost:5432/hotel_revenue_db?schema=public"
#
# 本番環境ではクラウドのマネージドPostgreSQLを利用する想定。特定クラウドの
# SDKには依存せず、DATABASE_URL（標準の postgresql:// 接続文字列）のみで
# 差し替え可能な構成になっている。
#
# AWS RDS for PostgreSQL の例:
# DATABASE_URL="postgresql://USER:PASSWORD@your-db-instance.xxxxxxxxxx.ap-northeast-1.rds.amazonaws.com:5432/hotel_revenue_db?schema=public&sslmode=require"
#
# GCP Cloud SQL for PostgreSQL の例（Public IP + SSL、もしくはCloud SQL Auth Proxy経由でlocalhost接続も可）:
# DATABASE_URL="postgresql://USER:PASSWORD@<CLOUD_SQL_PUBLIC_IP>:5432/hotel_revenue_db?schema=public&sslmode=require"

# -----------------
# Authentication (JWT)
# -----------------
# 必須。未設定、または32文字未満の場合はアプリ起動時に例外を投げて即座に停止する
# （backend/src/lib/auth.ts の requireJwtSecret を参照）。
# openssl rand -base64 64 で生成可能
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------
# API Rate Limiting
# -----------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ログイン試行専用のレート制限（ブルートフォース対策、W-4）。
# 未設定時のデフォルトは10（固定15分ウィンドウあたりの最大試行回数。
# ウィンドウ幅自体は backend/src/routes/auth.ts にハードコードされており
# RATE_LIMIT_WINDOW_MS の影響は受けない）。
LOGIN_RATE_LIMIT_MAX=10

# -----------------
# Logging
# -----------------
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------
# External APIs (Optional)
# -----------------
# OTA連携用API（楽天トラベル、Booking.comなど）
# RAKUTEN_API_KEY=
# BOOKING_API_KEY=
# JALAN_API_KEY=

# ---- 外部要因シグナル（docs/外部要因設計.md §3）。すべて任意。未設定・取得失敗時は該当要因なしで予測を続行する
# 外部API呼び出しのタイムアウト（ms）
# EXTERNAL_API_TIMEOUT_MS=10000
# 気象庁 bosai 予報JSON（キー不要）。通常は変更不要。テスト時にモックへ向ける用
# JMA_FORECAST_BASE_URL=https://www.jma.go.jp/bosai/forecast/data/forecast
# Open-Meteo（8〜16日先の補完）。SaaS提供は商用プラン（customer-api）が必要なため、キー未設定なら取得しない
# WEATHER_OPEN_METEO_ENABLED=false
# OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com
# OPEN_METEO_API_KEY=

# ---- 知識ベース（チャット・AIまとめの根拠となる Markdown。docs/knowledge/README.md 参照）
# backend/ 実行ディレクトリからの相対パス or 絶対パス。コンテナ運用では docs/knowledge をイメージに含めるか絶対パスで指定する
# KNOWLEDGE_DIR=../docs/knowledge

# ---- 日次ジョブ（天候取り込み→需要予測・価格決定→係数学習）。既定は無効（手動: POST /api/v1/pricing/jobs/daily）
# DAILY_JOB_ENABLED=false
# DAILY_JOB_HOUR_JST=4

# -----------------
# AI/ML Services (Optional)
# -----------------
# Claude API（Anthropic）
#   - 会場ページからのイベント候補抽出（POST /api/v1/events/venues/:id/extract）で使用。未設定なら抽出機能は 400 を返す
#   - AIコメント自動生成は Phase 4 で実装予定
# LLM は Anthropic（Claude）と OpenAI（ChatGPT / GPT）を切り替えられる。
#   既定プロバイダは LLM_PROVIDER、モデルは *_MODEL。ホテルごとの上書きは設定タブ（Hotel.llmProvider / llmModel）、
#   実行ごとの上書きは POST /api/v1/events/venues/:id/extract の llmProvider / llmModel
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# Azure OpenAI / 互換ゲートウェイを使う場合のみ
# OPENAI_BASE_URL=

# -----------------
# Redis (Optional - for caching/sessions)
# -----------------
# REDIS_URL=redis://localhost:6379
