# ===========================================
# Hotel Revenue Management System - Backend
# Environment Configuration Template
# ===========================================
# このファイルをコピーして .env を作成してください
# cp .env.example .env

# -----------------
# Server Settings
# -----------------
NODE_ENV=development
PORT=3001

# -----------------
# Frontend URL (CORS)
# -----------------
FRONTEND_URL=http://localhost:3000

# -----------------
# Database Settings
# -----------------
# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/hotel_revenue_db?schema=public"

# -----------------
# Authentication (JWT)
# -----------------
# 本番環境では強力なランダム文字列を使用してください
# openssl rand -base64 64 で生成可能
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------
# API Rate Limiting
# -----------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------
# Logging
# -----------------
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------
# External APIs (Optional)
# -----------------
# OTA連携用API（楽天トラベル、Booking.comなど）
# RAKUTEN_API_KEY=
# BOOKING_API_KEY=
# JALAN_API_KEY=

# 気象データAPI（天気予報連携用）
# WEATHER_API_KEY=

# -----------------
# AI/ML Services (Optional)
# -----------------
# OpenAI API for AI features
# OPENAI_API_KEY=

# -----------------
# Redis (Optional - for caching/sessions)
# -----------------
# REDIS_URL=redis://localhost:6379
