# ===========================================
# Hotel Revenue Management System - Backend
# Environment Configuration Template
# ===========================================
# このファイルをコピーして .env を作成してください
# cp .env.example .env

# -----------------
# Server Settings
# -----------------
NODE_ENV=development
PORT=3001

# -----------------
# Frontend URL (CORS)
# -----------------
FRONTEND_URL=http://localhost:3000

# -----------------
# Database Settings
# -----------------
# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# 【重要】テナント分離（Row Level Security / SAAS_DECISIONS.md D-01）
# アプリは superuser でも BYPASSRLS でもないロールで接続すること。
# superuser（postgres 等）で接続すると RLS が完全に素通りし、テナント分離が無効になる。
#   DATABASE_URL        … アプリ実行用。app_user（RLSが効くロール）
#   DIRECT_DATABASE_URL … マイグレーション・seed 用。DDL権限を持つ管理ロール
# ロールの作成は本番: prisma/rls-role.sql / 開発: docker/initdb/10-app-user.sql
#
# ローカル開発（docker/docker-compose.dev.yml のPostgres）:
DATABASE_URL="postgresql://app_user:app_password@localhost:5432/hotel_revenue_db?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:password@localhost:5432/hotel_revenue_db?schema=public"
#
# 本番環境ではクラウドのマネージドPostgreSQLを利用する想定。特定クラウドの
# SDKには依存せず、DATABASE_URL（標準の postgresql:// 接続文字列）のみで
# 差し替え可能な構成になっている。
#
# AWS RDS for PostgreSQL の例:
# DATABASE_URL="postgresql://USER:PASSWORD@your-db-instance.xxxxxxxxxx.ap-northeast-1.rds.amazonaws.com:5432/hotel_revenue_db?schema=public&sslmode=require"
#
# GCP Cloud SQL for PostgreSQL の例（Public IP + SSL、もしくはCloud SQL Auth Proxy経由でlocalhost接続も可）:
# DATABASE_URL="postgresql://USER:PASSWORD@<CLOUD_SQL_PUBLIC_IP>:5432/hotel_revenue_db?schema=public&sslmode=require"

# -----------------
# Tenant Isolation (RLS)
# -----------------
# リクエスト処理はテナントコンテキストのトランザクションで包まれる（D-01）。
# 長いほどDB接続を長く保持するため、Cloud SQL 等の接続上限と合わせて調整する。
DB_TRANSACTION_TIMEOUT_MS=20000
DB_TRANSACTION_MAX_WAIT_MS=5000

# RLS の統合テスト用。app_user の接続文字列を設定すると
# テナント越え遮断テストが実行される（未設定ならスキップ）
# RLS_TEST_DATABASE_URL="postgresql://app_user:app_password@localhost:5432/hotel_revenue_db?schema=public"

# -----------------
# Authentication (JWT)
# -----------------
# 必須。未設定、または32文字未満の場合はアプリ起動時に例外を投げて即座に停止する
# （backend/src/lib/auth.ts の requireJwtSecret を参照）。
# openssl rand -base64 64 で生成可能
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------
# API Rate Limiting
# -----------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ログイン試行専用のレート制限（ブルートフォース対策、W-4）。
# 未設定時のデフォルトは10（固定15分ウィンドウあたりの最大試行回数。
# ウィンドウ幅自体は backend/src/routes/auth.ts にハードコードされており
# RATE_LIMIT_WINDOW_MS の影響は受けない）。
LOGIN_RATE_LIMIT_MAX=10

# -----------------
# Logging
# -----------------
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------
# External APIs (Optional)
# -----------------
# OTA連携用API（楽天トラベル、Booking.comなど）
# RAKUTEN_API_KEY=
# BOOKING_API_KEY=
# JALAN_API_KEY=

# 気象データAPI（天気予報連携用）
# WEATHER_API_KEY=

# -----------------
# AI/ML Services (Optional)
# -----------------
# Claude API（Anthropic）— AIコメント自動生成機能用（Phase 4で実装予定）
# ANTHROPIC_API_KEY=

# -----------------
# Redis (Optional - for caching/sessions)
# -----------------
# REDIS_URL=redis://localhost:6379
