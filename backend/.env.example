# ===========================================
# Hotel Revenue Management System - Backend
# Environment Configuration Template
# ===========================================
# このファイルをコピーして .env を作成してください
# cp .env.example .env

# -----------------
# Server Settings
# -----------------
NODE_ENV=development
PORT=3001

# -----------------
# Frontend URL (CORS)
# -----------------
# CORS で許可するオリジン。カンマ区切りで複数指定できる（S-10）。
# 各値は完全な URL（スキーム込み・末尾スラッシュなし）であること。
# Vercel の Preview URL を許可する例:
#   FRONTEND_URL=https://hotel-price.vercel.app,https://hotel-price-git-feature-team.vercel.app
# 開発時（NODE_ENV!=production）は http://localhost:3000 と http://127.0.0.1:3000 が自動で追加される。
# 認証は Cookie ではなく Authorization: Bearer ヘッダなので CORS の credentials は有効にしない。
FRONTEND_URL=http://localhost:3000

# -----------------
# Database Settings
# -----------------
# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# ローカル開発（docker/docker-compose.dev.yml のPostgres）:
DATABASE_URL="postgresql://postgres:password@localhost:5432/hotel_revenue_db?schema=public"
#
# 本番環境ではクラウドのマネージドPostgreSQLを利用する想定。特定クラウドの
# SDKには依存せず、DATABASE_URL（標準の postgresql:// 接続文字列）のみで
# 差し替え可能な構成になっている。
#
# AWS RDS for PostgreSQL の例:
# DATABASE_URL="postgresql://USER:PASSWORD@your-db-instance.xxxxxxxxxx.ap-northeast-1.rds.amazonaws.com:5432/hotel_revenue_db?schema=public&sslmode=require"
#
# GCP Cloud SQL for PostgreSQL の例（Public IP + SSL、もしくはCloud SQL Auth Proxy経由でlocalhost接続も可）:
# DATABASE_URL="postgresql://USER:PASSWORD@<CLOUD_SQL_PUBLIC_IP>:5432/hotel_revenue_db?schema=public&sslmode=require"

# -----------------
# Authentication (JWT)
# -----------------
# 必須。未設定、または32文字未満の場合はアプリ起動時に例外を投げて即座に停止する。
#
# このテンプレートには既定値を書かない（S-7）。プレースホルダを置くと 32 文字の
# 検証を通過してしまい、そのまま本番に持ち込まれる事故につながるため、
# 各環境で必ず新しい値を生成して設定すること:
#
#   openssl rand -base64 64 | tr -d '\n'
#
JWT_SECRET=
# アクセストークンの有効期限。既定 15m（#78）。無効化・降格は期限を待たずに反映される
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------
# Reverse Proxy
# -----------------
# リバースプロキシ／ロードバランサ（Vercel rewrite、ALB、Cloud Run、nginx 等）の背後で動かす場合、
# X-Forwarded-For からクライアント IP を取得するために Express の 'trust proxy' を設定する。
# 値はそのまま app.set('trust proxy', ...) に渡される:
#   1          … 直前の 1 ホップ（一般的なロードバランサ構成。推奨）
#   true       … 全てのプロキシを信頼（クライアントが X-Forwarded-For を偽装できるため非推奨）
#   loopback   … ループバックアドレスのみ信頼
# 未設定なら信頼しない（直接接続元の IP を使う）。
# frontend（Next.js）の /api/* 中継の背後で動かす通常の構成では 1 にする。中継はクライアントが送った
# X-Forwarded-For を捨て、解決したクライアント IP だけを渡す（#85 / README「クライアント IP の扱い」）。
# TRUST_PROXY=1

# -----------------
# API Rate Limiting
# -----------------
# 認証済みリクエストはユーザー単位、未認証は IP 単位でカウントする（/health は対象外）。
# 既定は 15 分あたり 1000 リクエスト。
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ログイン試行専用のレート制限（ブルートフォース対策、W-4）。
# 未設定時のデフォルトは10（固定15分ウィンドウあたりの最大試行回数。
# ウィンドウ幅自体は backend/src/routes/auth.ts にハードコードされており
# RATE_LIMIT_WINDOW_MS の影響は受けない）。
LOGIN_RATE_LIMIT_MAX=10

# 日次バッチ（job daily）が着地シミュレーションとアラート判定を行う範囲。当月＋先の月数、既定3（#83）
DAILY_JOB_MONTHS_AHEAD=3

# トークン更新（POST /api/v1/auth/refresh）の IP 単位の上限。15 分あたり、既定 60（#78）
REFRESH_RATE_LIMIT_MAX=60

# -----------------
# Logging
# -----------------
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------
# Report storage
# -----------------
# 月次レポート（PDF/Excel）のキャッシュの保存先。local（ローカルディスク）か s3（S3 互換 API — #21）。
# local はコンテナの再起動・複数レプリカで共有されないため、複数レプリカの本番では s3 にする（#49-7）
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
# STORAGE_DRIVER=s3 のときに必須（AWS S3・Cloudflare R2・GCS の相互運用 API・MinIO で動く）
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# AWS 以外はエンドポイントを指定する（例: R2 は https://<account>.r2.cloudflarestorage.com、GCS は https://storage.googleapis.com）
# S3_ENDPOINT=
# S3_REGION=auto
# MinIO などパス形式のサービスでは true
# S3_FORCE_PATH_STYLE=false
# 1つのバケットを環境ごとに分けるときの接頭辞（例: prod/）
# S3_KEY_PREFIX=

# -----------------
# 競合価格の取得元（services/competitorRates — #9）
# -----------------
# 楽天トラベルの空室検索 API（楽天ウェブサービスで発行するアプリ ID）。未設定なら楽天の自動取得はしない
# RAKUTEN_APPLICATION_ID=
# RAKUTEN_TRAVEL_API_URL=https://app.rakuten.co.jp/services/api/Travel/VacantHotelSearch/20170426
# RAKUTEN_REQUEST_INTERVAL_MS=1100   # API の利用条件（1秒に1回まで）より短くできない

# -----------------
# Mail（lib/mailer.ts — #89, #21）
# -----------------
# 招待（パスワードを省略したユーザー登録）と一時パスワードの再発行を本人にメールで届ける。
# none: 送信しない（一時パスワードは画面で管理者に1回だけ表示）/ smtp: SMTP で送信 / memory: テスト用（本番不可）
MAIL_DRIVER=none
# smtp のとき必須。差出人とホストにフォールバック値は無い
# MAIL_FROM="AIレベニュー管理 <no-reply@example.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false          # 465（SMTPS）なら true
# SMTP_USER=                 # 認証する場合は SMTP_PASS と両方設定する
# SMTP_PASS=
# メール本文のログイン画面の URL（未設定なら FRONTEND_URL の先頭）
# APP_PUBLIC_URL=https://app.example.com

# -----------------
# Container（docker/backend-entrypoint.sh）
# -----------------
# true のときだけ、API サーバーの起動前にマイグレーションを適用する（単一レプリカの検証環境向け）。
# 本番はリリース時に `docker run <image> migrate` を別ジョブで1回だけ実行し、ここは設定しない（docs/運用手順書.md）
# MIGRATE_ON_START=true

# -----------------
# Phase 4 で使う予定の外部サービス（現在のコードは読まない）
# -----------------
# 以下は lib/config.ts のスキーマに無く、設定しても何も起きない。連携を実装するときに config.ts へ追加する。
# RAKUTEN_API_KEY=            # OTA 連携
# BOOKING_API_KEY=
# JALAN_API_KEY=
# WEATHER_API_KEY=            # 気象データ
# ANTHROPIC_API_KEY=          # Claude API による AI コメント生成
