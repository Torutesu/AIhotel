# ===========================================
# Hotel Revenue Management System - Frontend
# Environment Configuration Template
# ===========================================
# このファイルをコピーして .env.local を作成してください
# cp .env.example .env.local

# バックエンドAPIのURL（next.config.mjs のrewrites先）
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# -----------------
# デモモード（クライアントへのUI確認・デモ用）
# -----------------
# true にすると、バックエンドに接続できない場合のみ frontend/lib/api.ts の
# デモアカウント（admin@demo-hotel.example.com 等 / Admin1234）でログインでき、
# 全画面にダミーデータを表示する（実データではない）。
# フォールバックが発生した場合は画面上部にデモ表示バナーを出すため、
# 「モックへのサイレントフォールバック禁止」の規約には抵触しない。
#
# 未設定時の既定値は next.config.mjs で true。バックエンドが正常応答する限り常に実APIを優先する。
# 本番でバックエンドを接続したら、ホスティング側の環境変数で false を設定して無効化すること。
NEXT_PUBLIC_DEMO_MODE=true
