# ===========================================
# Hotel Revenue Management System - Frontend
# Environment Configuration Template
# ===========================================
# このファイルをコピーして .env.local を作成してください
# cp .env.example .env.local

# -----------------
# バックエンドAPIの接続先（サーバー専用）
# -----------------
# ブラウザは常に same-origin（/api/*）でアクセスし、Next.js のルートハンドラ
# （app/api/[...path]/route.ts）がここで指定したバックエンドへ毎リクエスト中継する。
# サーバー側でのみ読まれる変数のためブラウザには露出しない。
# 未設定時は http://localhost:3001 にフォールバックする。
BACKEND_URL=http://localhost:3001

# 非推奨: 旧構成との後方互換のためのフォールバック。BACKEND_URL を使うこと。
# ブラウザのAPIベースURLとしては使われない（クロスオリジン直叩きを避けるため）。
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# backend と共有する秘密の値（サーバー専用 — R-2-3）。backend の PROXY_SHARED_SECRET と同じ値にする。
# 中継がバックエンドへの要求に付け、backend は一致しない要求を拒否する。ブラウザには出ない。
# backend が未設定なら、ここも設定しなくてよい。
# PROXY_SHARED_SECRET=

# -----------------
# クライアント IP の解決（サーバー専用 — #85）
# -----------------
# Next.js の前段にある信頼できるリバースプロキシ／ロードバランサの段数。既定 1。
# API 中継はクライアントが送った X-Forwarded-For を捨て、右からこの段数目の値だけを
# バックエンドへ渡す（バックエンドは TRUST_PROXY=1 にする）。
# Vercel 上では無視される（Vercel のエッジが設定した値を使う）。
# Next.js を前段プロキシなしで直接インターネットに公開しないこと（IP を偽装できる）。
# TRUSTED_PROXY_HOPS=1

# -----------------
# Vercel Analytics
# -----------------
# Vercel が自動で設定する変数。設定されている場合のみ @vercel/analytics を読み込む。
# セルフホストでは設定しないこと（Insights スクリプトが 404 になる）。
# NEXT_PUBLIC_VERCEL_ENV=production

# -----------------
# デモモード（クライアントへのUI確認・デモ用。opt-in、既定は無効）
# -----------------
# true にすると、バックエンドに接続できない場合のみ frontend/lib/api.ts の
# デモアカウント（admin@demo-hotel.example.com 等 / Admin1234）でログインでき、
# 全画面にダミーデータを表示する（実データではない）。ログイン画面のデモ認証情報も
# このときだけ表示される。フォールバックが発生した場合は画面上部にデモ表示バナーを出すため、
# 「モックへのサイレントフォールバック禁止」の規約には抵触しない。
#
# 判定は「true のときだけ有効」。未設定・値の誤りの場合はデモモードは無効（本番の既定）。
# 本番ビルドではこの変数を設定しないこと（デモ処理はバンドルから除去される。
# `node scripts/verify-demo-mode.mjs --expect-disabled` で確認できる）。
# デモ用ビルドでのみ true を設定する（ビルド時の変数のため、変更後は再ビルドが必要）。
# NEXT_PUBLIC_DEMO_MODE=true
