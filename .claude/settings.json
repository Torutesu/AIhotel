{
  "permissions": {
    "allow": [
      "Bash(pnpm --filter *)",
      "Bash(pnpm install)",
      "Bash(pnpm type-check)",
      "Bash(pnpm test)",
      "Bash(pnpm lint)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./backend/.env)",
      "Read(./frontend/.env.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Bash(npx prisma migrate reset*)",
      "Bash(pnpm --filter backend db:push*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-dangerous.sh"
          }
        ]
      }
    ]
  }
}
